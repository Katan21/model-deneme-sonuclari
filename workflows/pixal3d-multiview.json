{
 "id": "pixal3d-multiview",
 "name": "Pixal3D Multiview (dokulu, 4 görünüş)",
 "category": "3d",
 "inputs": ["image"],
 "max_inputs": 4,
 "outputs": ["glb"],
 "params": {},
 "workflow": {
  "1": {"class_type": "LoadImage", "inputs": {"image": "{{image1}}"}},
  "2": {"class_type": "LoadImage", "inputs": {"image": "{{image2}}"}},
  "3": {"class_type": "LoadImage", "inputs": {"image": "{{image3}}"}},
  "4": {"class_type": "LoadImage", "inputs": {"image": "{{image4}}"}},
  "10": {"class_type": "LoadBackgroundRemovalModel", "inputs": {"bg_removal_name": "birefnet.safetensors"}},
  "11": {"class_type": "RemoveBackground", "inputs": {"image": ["1", 0], "bg_removal_model": ["10", 0]}},
  "12": {"class_type": "RemoveBackground", "inputs": {"image": ["2", 0], "bg_removal_model": ["10", 0]}},
  "13": {"class_type": "RemoveBackground", "inputs": {"image": ["3", 0], "bg_removal_model": ["10", 0]}},
  "14": {"class_type": "RemoveBackground", "inputs": {"image": ["4", 0], "bg_removal_model": ["10", 0]}},
  "15": {"class_type": "ImageCropToMask", "inputs": {"images": ["1", 0], "masks": ["11", 0], "width": 1024, "height": 1024, "pad_factor": 1.1, "grow_mask": 0, "background": "#000000"}},
  "16": {"class_type": "ImageCropToMask", "inputs": {"images": ["2", 0], "masks": ["12", 0], "width": 1024, "height": 1024, "pad_factor": 1.1, "grow_mask": 0, "background": "#000000"}},
  "17": {"class_type": "ImageCropToMask", "inputs": {"images": ["3", 0], "masks": ["13", 0], "width": 1024, "height": 1024, "pad_factor": 1.1, "grow_mask": 0, "background": "#000000"}},
  "18": {"class_type": "ImageCropToMask", "inputs": {"images": ["4", 0], "masks": ["14", 0], "width": 1024, "height": 1024, "pad_factor": 1.1, "grow_mask": 0, "background": "#000000"}},
  "20": {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "dino_v3_L_naf_fp32.safetensors"}},
  "21": {"class_type": "Pixal3DMultiViewConditioning", "inputs": {"clip_vision_model": ["20", 0], "fov": 20.0, "front": ["15", 0], "left": ["16", 0], "back": ["17", 0], "right": ["18", 0]}},
  "30": {"class_type": "UNETLoader", "inputs": {"unet_name": "pixal3d_multiview_int8_convrot.safetensors", "weight_dtype": "default"}},
  "31": {"class_type": "CFGOverride", "inputs": {"model": ["30", 0], "cfg": 1.0, "start_percent": 0.667, "end_percent": 1.0}},
  "32": {"class_type": "RescaleCFG", "inputs": {"model": ["31", 0], "multiplier": 0.7}},
  "33": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["32", 0], "shift": 5.0}},
  "34": {"class_type": "EmptyTrellis2LatentStructure", "inputs": {"batch_size": 1}},
  "35": {"class_type": "KSampler", "inputs": {"model": ["33", 0], "seed": "{{seed}}", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "positive": ["21", 0], "negative": ["21", 1], "latent_image": ["34", 0], "denoise": 1.0}},
  "40": {"class_type": "VAELoader", "inputs": {"vae_name": "trellis_2_shape_vae_bf16.safetensors"}},
  "41": {"class_type": "VAELoader", "inputs": {"vae_name": "trellis_2_texture_vae_bf16.safetensors"}},
  "42": {"class_type": "VaeDecodeStructureTrellis2", "inputs": {"samples": ["35", 0], "vae": ["40", 0], "resolution": "32"}},
  "50": {"class_type": "Trellis2ShapeStage", "inputs": {"positive": ["21", 0], "negative": ["21", 1], "voxel": ["42", 0]}},
  "51": {"class_type": "CFGOverride", "inputs": {"model": ["30", 0], "cfg": 1.0, "start_percent": 0.769, "end_percent": 1.0}},
  "52": {"class_type": "RescaleCFG", "inputs": {"model": ["51", 0], "multiplier": 0.5}},
  "53": {"class_type": "KSampler", "inputs": {"model": ["52", 0], "seed": "{{seed}}", "steps": 20, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "positive": ["50", 0], "negative": ["50", 1], "latent_image": ["50", 2], "denoise": 1.0}},
  "54": {"class_type": "Trellis2UpsampleStage", "inputs": {"positive": ["50", 0], "negative": ["50", 1], "shape_latent": ["53", 0], "vae": ["40", 0], "target_resolution": 1536}},
  "55": {"class_type": "KSampler", "inputs": {"model": ["52", 0], "seed": "{{seed}}", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "simple", "positive": ["54", 0], "negative": ["54", 1], "latent_image": ["54", 2], "denoise": 1.0}},
  "56": {"class_type": "VaeDecodeShapeTrellis", "inputs": {"samples": ["55", 0], "vae": ["40", 0]}},
  "60": {"class_type": "Trellis2TextureStage", "inputs": {"positive": ["54", 0], "negative": ["54", 1], "shape_latent": ["55", 0]}},
  "61": {"class_type": "KSampler", "inputs": {"model": ["30", 0], "seed": "{{seed}}", "steps": 12, "cfg": 1.0, "sampler_name": "euler", "scheduler": "normal", "positive": ["60", 0], "negative": ["60", 1], "latent_image": ["60", 2], "denoise": 1.0}},
  "62": {"class_type": "VaeDecodeTextureTrellis", "inputs": {"samples": ["61", 0], "vae": ["41", 0], "shape_subdivides": ["56", 1]}},
  "72": {"class_type": "DecimateMesh", "inputs": {"mesh": ["56", 0], "target_face_count": 700000, "placement_mode": "midpoint"}},
  "73": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["72", 0], "crease_angle": 180}},
  "74": {"class_type": "UnwrapMesh", "inputs": {"mesh": ["73", 0], "segmenter": "pec", "resolution": 2048, "padding": 1, "weld_distance": 0.0002}},
  "75": {"class_type": "BakeTextureFromVoxel", "inputs": {"mesh": ["74", 0], "voxel_colors": ["62", 0], "texture_size": 4096, "reference_mesh": ["56", 0]}},
  "76": {"class_type": "BakeNormalMapFromMesh", "inputs": {"low_poly": ["74", 0], "high_poly": ["56", 0], "resolution": 2048, "cage_distance": 0.05, "ignore_backfaces": true}},
  "77": {"class_type": "BakeAmbientOcclusion", "inputs": {"low_poly": ["74", 0], "high_poly": ["56", 0], "resolution": 1024, "samples": 64, "max_distance": 0.71, "strength": 1.0, "bias": 0.01}},
  "80": {"class_type": "ApplyTextureToMesh", "inputs": {"mesh": ["74", 0], "base_color": ["75", 0], "metallic": ["75", 1], "roughness": ["75", 2], "occlusion": ["77", 0], "normal_map": ["76", 0]}},
  "81": {"class_type": "MeshSmoothNormals", "inputs": {"mesh": ["80", 0], "crease_angle": 180}},
  "82": {"class_type": "MeshToFile3D", "inputs": {"mesh": ["81", 0]}},
  "83": {"class_type": "SaveGLB", "inputs": {"mesh": ["82", 0], "filename_prefix": "{{prefix}}"}}
 }
}
